# Copy to .env.local and fill in. Add the same values in your hosting settings (e.g. Vercel).

# Sanity (sanity.io/manage → your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only for `npm run sanity:seed`: an API token with Editor rights (sanity.io/manage → API → Tokens).
# Keep it secret; it is never sent to the browser.
SANITY_API_WRITE_TOKEN=

# Optional: secret shared with the Sanity webhook that refreshes the site on publish
SANITY_REVALIDATE_SECRET=

# Contact form email (see app/api/contact/route.ts)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
